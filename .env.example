# ─── App ───
NEXT_PUBLIC_SITE_URL=https://haapily.in
NEXT_PUBLIC_WHATSAPP_NUMBER=91XXXXXXXXXX      # no +, no spaces
NEXT_PUBLIC_INSTAGRAM_HANDLE=haapily.in

# ─── Database (Supabase or Neon Postgres) ───
DATABASE_URL=postgresql://...pooled...        # app runtime (pooler, port 6543 on Supabase)
DIRECT_URL=postgresql://...direct...          # migrations only (port 5432)

# ─── Auth.js v5 ───
AUTH_SECRET=                                  # openssl rand -base64 32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── Payments ───
# test → rzp_test_ keys, "Test Mode" badge on checkout, no real money
# live → rzp_live_ keys. App refuses to boot if keys don't match the mode.
PAYMENT_MODE=test
RAZORPAY_TEST_KEY_ID=rzp_test_
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_LIVE_KEY_ID=rzp_live_
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Tax ───
# false → no tax lines, invoices without GSTIN, HSN hidden
GST_ENABLED=false
GSTIN=
BUSINESS_STATE_CODE=                          # GST state code of your registered address (e.g. 33 = Tamil Nadu)

# ─── Media (Cloudinary) ───
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email (Resend) ───
RESEND_API_KEY=
EMAIL_FROM="Haapily <hello@haapily.in>"
ADMIN_ALERT_EMAIL=

# ─── Rate limiting (Upstash Redis — optional until traffic justifies it) ───
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Monitoring ───
SENTRY_DSN=
